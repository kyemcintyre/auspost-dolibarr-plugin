{
  "branches": [
    "main",
    "master"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "ChangeLog.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "php scripts/set_version.php ${nextRelease.version} && php scripts/build_package.php ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "core/modules/modAuspost.class.php",
          "composer.json",
          "ChangeLog.md"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/*.zip",
            "label": "Dolibarr Module Package (v${nextRelease.version})"
          }
        ]
      }
    ]
  ]
}
